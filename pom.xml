<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.7</version>
    <relativePath/>
  </parent>

  <groupId>com.finance</groupId>
  <artifactId>finance-suite</artifactId>
  <version>0.5.3</version>
  <packaging>pom</packaging>

  <modules>
    <module>finance-domain</module>
    <module>finance-statements</module>
    <module>finance-server</module>
    <module>finance-importer</module>
  </modules>

  <properties>
    <java.version>21</java.version>

    <spring-ai.version>1.1.8</spring-ai.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <playwright.version>1.55.0</playwright.version>

    <!-- Lombok -->
    <lombok.version>1.18.42</lombok.version>
  </properties>

  <dependencyManagement>
    <dependencies>

      <dependency>
        <groupId>com.finance</groupId>
        <artifactId>finance-domain</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>com.finance</groupId>
        <artifactId>finance-statements</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

</project>